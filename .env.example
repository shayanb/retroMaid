# retroMaid Environment Variables
# Copy this file to .env and fill in your credentials

# ScreenScraper Credentials
SCREENSCRAPER_USERNAME=your_username
SCREENSCRAPER_PASSWORD=your_password

# Optional: ScreenScraper Developer Credentials (for higher quotas)
SCREENSCRAPER_DEV_ID=
SCREENSCRAPER_DEV_PASSWORD=

# Optional: TheGamesDB API Key
THEGAMESDB_API_KEY=

# Optional: IGDB Credentials
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
